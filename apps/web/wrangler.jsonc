// Cloudflare Workers static assets for the hosted web app (no Worker code).
{
  "name": "gitui",
  "compatibility_date": "2026-11-01",
  // Served at HOSTED_ORIGIN only: the CLI accepts no other origin, so a workers.dev URL or a
  // preview deployment couldn't pair.
  "routes": [{ "pattern": "gitui.diffiii.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "env": {
    // A copy for trying nearby on a real phone before gitui.diffiii.dev gets it:
    // `bunx wrangler deploy --env nearby-test` (apps/rendezvous/README.md, "First test on a
    // phone"). The rendezvous must allow its origin (ALLOWED_ORIGINS). It can't pair with a CLI
    // over 127.0.0.1 unless that CLI runs with `--allow-origin https://gitui-test.diffiii.dev`.
    "nearby-test": {
      "name": "gitui-nearby-test",
      "routes": [{ "pattern": "gitui-test.diffiii.dev", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
    },
  },
}
