// A copy of the hosted web app for trying nearby on a real phone before gitui.diffiii.dev gets
// it: `bun run deploy:nearby-test` (apps/rendezvous/README.md, "First test on a phone").
// The rendezvous must allow its origin (ALLOWED_ORIGINS). It can't pair with a CLI over
// 127.0.0.1 unless that CLI runs with `--allow-origin https://gitui-test.diffiii.dev`.
// To remove it: `bunx wrangler delete -c wrangler.nearby-test.jsonc`, then delete this file.
{
  "name": "gitui-nearby-test",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "gitui-test.diffiii.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // `wrangler deploy` builds first, from the repo root and with the production rendezvous, so it
  // never ships whatever dist/ held (say, a dev build). Wrangler runs it in its own working
  // directory, not this file's, so it finds the root with git: run wrangler inside the repo.
  "build": {
    "command": "root=\"$(git rev-parse --show-toplevel)\" && cd \"$root\" && VITE_GITUI_RENDEZVOUS_URL= bun run build",
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
