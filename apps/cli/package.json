{
  "name": "@diffiii/gitui",
  "version": "0.4.0",
  "description": "A lazygit-inspired git client that runs in your browser on localhost",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diffiii/gitui.git",
    "directory": "apps/cli"
  },
  "bin": {
    "gitui": "./dist/gitui.js"
  },
  "files": [
    "dist/gitui.js"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun --watch server/dev.ts",
    "build": "bun scripts/build.ts"
  },
  "devDependencies": {
    "@gitui/shared": "workspace:*",
    "@hono/node-server": "^2.1.11",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@pierre/diffs": "^1.6.4",
    "@types/ws": "8.18.2",
    "hono": "^4.13.19",
    "werift": "0.26.0",
    "ws": "8.22.1"
  },
  "engines": {
    "node": ">=22.1.0"
  }
}
