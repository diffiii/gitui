{
  "name": "gitui",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "tsc -b && bun run --cwd apps/web build && bun run --cwd apps/cli build",
    "start": "bun apps/cli/bin/gitui.ts",
    "check": "vp check",
    "lint": "vp lint",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "mediabunny": "1.65.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.5",
      "onFail": "download"
    }
  }
}
